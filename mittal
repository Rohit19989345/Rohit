def is_palindrome(text):
    """Return True if text reads the same forward and backward."""
    normalized = "".join(char.casefold() for char in text if char.isalnum())
    return normalized == normalized[::-1]


if __name__ == "__main__":
    value = input("Enter text: ")
    print("Palindrome" if is_palindrome(value) else "Not a palindrome")
def two_pointer_sum(numbers, target):
	"""Find a pair summing to target in an ascending list; return their values."""
	left, right = 0, len(numbers) - 1
	while left < right:
		total = numbers[left] + numbers[right]
		if total == target:
			return numbers[left], numbers[right]
		if total < target:
			left += 1
		else:
			right -= 1
	return None
